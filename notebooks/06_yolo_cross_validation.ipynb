{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# YOLOv8s Segmentation Training with 5-Fold Cross-Validation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "This notebook sets up and runs a 5-fold cross-validation training for a YOLOv8s segmentation model. It handles the data preparation, training for each fold, and aggregation of results."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Import libraries and define paths."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import yaml\n",
    "from sklearn.model_selection import KFold\n",
    "from ultralytics import YOLO"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define paths\n",
    "ROOT_DIR = Path('../')\n",
    "DATA_DIR = ROOT_DIR / 'data' / 'processed'\n",
    "CV_DATA_DIR = ROOT_DIR / 'cv_data'\n",
    "MODEL_CONFIG_PATH = ROOT_DIR / 'configurations' / 'model_data-seg.yaml'\n",
    "PRETRAINED_MODEL_PATH = ROOT_DIR / 'yolov8s-seg.pt'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Preparation for Cross-Validation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Combine the existing training and validation sets and then split them into 5 folds."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine all images and labels\n",
    "all_images = sorted(list(DATA_DIR.glob('images/train/*.tif'))) + sorted(list(DATA_DIR.glob('images/val/*.tif')))\n",
    "all_labels = sorted(list(DATA_DIR.glob('labels/train/*.txt'))) + sorted(list(DATA_DIR.glob('labels/val/*.txt')))\n",
    "\n",
    "# Ensure images and labels correspond\n",
    "assert len(all_images) == len(all_labels), \"Mismatch between number of images and labels\"\n",
    "for img, lbl in zip(all_images, all_labels):\n",
    "    assert img.stem == lbl.stem, f\"Mismatch between {img.name} and {lbl.name}\"\n",
    "\n",
    "print(f\"Total images for CV: {len(all_images)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create the main CV directory\n",
    "if CV_DATA_DIR.exists():\n",
    "    shutil.rmtree(CV_DATA_DIR)\n",
    "CV_DATA_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "# Setup KFold\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
    "all_images = np.array(all_images)\n",
    "\n",
    "# Get class names from original data config\n",
    "with open(MODEL_CONFIG_PATH, 'r') as f:\n",
    "    model_config = yaml.safe_load(f)\n",
    "class_names = model_config['names']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for i, (train_index, val_index) in enumerate(kf.split(all_images)):\n",
    "    fold_dir = CV_DATA_DIR / f'fold_{i}'\n",
    "    \n",
    "    # Create directories for the fold\n",
    "    (fold_dir / 'images' / 'train').mkdir(parents=True, exist_ok=True)\n",
    "    (fold_dir / 'images' / 'val').mkdir(parents=True, exist_ok=True)\n",
    "    (fold_dir / 'labels' / 'train').mkdir(parents=True, exist_ok=True)\n",
    "    (fold_dir / 'labels' / 'val').mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    # Copy training files\n",
    "    for idx in train_index:\n",
    "        img_path = all_images[idx]\n",
    "        lbl_path = Path(str(img_path).replace('images', 'labels').replace('.tif', '.txt'))\n",
    "        shutil.copy(img_path, fold_dir / 'images' / 'train' / img_path.name)\n",
    "        shutil.copy(lbl_path, fold_dir / 'labels' / 'train' / lbl_path.name)\n",
    "        \n",
    "    # Copy validation files\n",
    "    for idx in val_index:\n",
    "        img_path = all_images[idx]\n",
    "        lbl_path = Path(str(img_path).replace('images', 'labels').replace('.tif', '.txt'))\n",
    "        shutil.copy(img_path, fold_dir / 'images' / 'val' / img_path.name)\n",
    "        shutil.copy(lbl_path, fold_dir / 'labels' / 'val' / lbl_path.name)\n",
    "        \n",
    "    # Create YAML file for the fold\n",
    "    fold_yaml_path = fold_dir / f'fold_{i}_data.yaml'\n",
    "    fold_data_config = {\n",
    "        'path': str(fold_dir.resolve()),\n",
    "        'train': str((fold_dir / 'images' / 'train').resolve()),\n",
    "        'val': str((fold_dir / 'images' / 'val').resolve()),\n",
    "        'names': class_names\n",
    "    }\n",
    "    with open(fold_yaml_path, 'w') as f:\n",
    "        yaml.dump(fold_data_config, f)\n",
    "        \n",
    "    print(f"Fold {i} created.")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Cross-Validation Training"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Loop through each fold and train the model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in range(5):\n",
    "    print(f"\n--- Training Fold {i} ---")\n",
    "    \n",
    "    # Load pretrained model\n",
    "    model = YOLO(PRETRAINED_MODEL_PATH)\n",
    "    \n",
    "    # Get data config for the fold\n",
    "    fold_yaml_path = CV_DATA_DIR / f'fold_{i}' / f'fold_{i}_data.yaml'\n",
    "    \n",
    "    # Train the model\n",
    "    model.train(\n",
    "        data=str(fold_yaml_path.resolve()),\n",
    "        epochs=25, # Using a smaller number of epochs for demonstration\n",
    "        imgsz=640,\n",
    "        project='YOLOv8s_CV',\n",
    "        name=f'fold_{i}',\n",
    "        exist_ok=True # Allows re-running the notebook\n",
    "    )\n",
    "    \n",
    "    # Clear memory\n",
    "    del model\n",
    "    torch.cuda.empty_cache()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Results Aggregation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Combine the results from all folds and calculate the mean and standard deviation of the key metrics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results_dir = Path('./YOLOv8s_CV')\n",
    "all_results = []\n",
    "\n",
    "for i in range(5):\n",
    "    fold_results_path = results_dir / f'fold_{i}' / 'results.csv'\n",
    "    if fold_results_path.exists():\n",
    "        df = pd.read_csv(fold_results_path)\n",
    "        df['fold'] = i\n",
    "        all_results.append(df)\n",
    "\n",
    "if all_results:\n",
    "    cv_results_df = pd.concat(all_results)\n",
    "    \n",
    "    # Get the metrics from the last epoch of each fold\n",
    "    last_epoch_results = cv_results_df.groupby('fold').last().reset_index()\n",
    "    \n",
    "    print(\"--- Cross-Validation Results Summary (Last Epoch of Each Fold) ---")\n",
    "    print(last_epoch_results[['fold', 'metrics/mAP50(B)', 'metrics/mAP50-95(B)', 'metrics/mAP50(M)', 'metrics/mAP50-95(M)']])\n",
    "    \n",
    "    print(\"\n--- Mean and Std Dev of Metrics ---")\n",
    "    mean_metrics = last_epoch_results[['metrics/mAP50(B)', 'metrics/mAP50-95(B)', 'metrics/mAP50(M)', 'metrics/mAP50-95(M)']].mean()\n",
    "    std_metrics = last_epoch_results[['metrics/mAP50(B)', 'metrics/mAP50-95(B)', 'metrics/mAP50(M)', 'metrics/mAP50-95(M)']].std()\n",
    "    \n",
    "    summary_df = pd.DataFrame({'mean': mean_metrics, 'std_dev': std_metrics})\n",
    "    print(summary_df)\n",
    "else:\n",
    "    print(\"No results found. Please ensure the training completed successfully.")"
   ]
  }
 ],
